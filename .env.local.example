# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. .env.local은 git에 올라가지 않습니다.
#
# 모듈별로 저장소를 따로 씁니다 (담당자별로 개발이 독립되도록).
# 자기 담당 모듈의 값만 채우면 나머지 모듈은 미설정 상태로 남고, 앱은 그대로 뜹니다.

# ---------------------------------------------------------------------------
# 오버홀 공정관리 · 고장이력 관리 · 정비 챗봇 공용 (Postgres)
#
# 아무것도 채우지 않으면 로컬은 계정·서버 없이 PGlite로 그대로 동작합니다.
# DATABASE_URL을 채우면 그 순간부터 로컬도 같은 Postgres(Supabase 등)를 씁니다 —
# 여러 사람이 같은 데이터를 봐야 할 때만 채우세요.
#
# Supabase 대시보드 → Project Settings → Database → Connection string
# 서버리스(Vercel)에서 쓸 값: "Transaction pooler" (포트 6543)
# ---------------------------------------------------------------------------
DATABASE_URL=

# db/schema.sql을 처음 적용할 때(npm run db:migrate)만 쓰는 값 — 선택사항.
# Transaction pooler는 DDL 배치 실행 중 세션 제약이 있을 수 있으니,
# 마이그레이션만은 "Direct connection"(포트 5432) 문자열을 따로 넣어도 된다.
# 비워두면 DATABASE_URL을 그대로 쓴다.
MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------
# 문서 자동생성 전용 (사진대장 / 매뉴얼 / 고장 보고서)
#
# 이 모듈만 Supabase를 직접 씁니다 — PDF 원본을 Storage에 보관해야 하는데
# 위의 Postgres 연결만으로는 파일 저장소가 없기 때문입니다.
# Supabase 프로젝트 "통합본-1" 의 값을 넣습니다.
# 먼저 그 프로젝트의 SQL Editor 에서 supabase/docgen/01-docgen-schema.sql 을
# 한 번 실행해야 보관함이 동작합니다.
#
# ⛔ 뚝 DOC(legacy Photo-Report) 프로젝트의 값을 넣지 마세요. 뚝 DOC 은 별개로
#    운영되는 웹앱이며, 같은 프로젝트를 쓰면 두 앱의 보관함이 섞입니다.
#
# ⚠️ anon(publishable) 키를 넣습니다. 브라우저에 노출되어도 안전한 키이며,
#    실제 보안은 Supabase 쪽 RLS 정책이 담당합니다.
#    service_role 키를 넣으면 모든 정책이 우회되므로 절대 넣지 마세요.
#
# 비워 두면 보관함만 숨겨지고, PDF 생성·다운로드는 그대로 됩니다.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DOCGEN_SUPABASE_URL=
NEXT_PUBLIC_DOCGEN_SUPABASE_ANON_KEY=
